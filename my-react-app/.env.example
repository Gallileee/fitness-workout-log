# Copy to .env and fill in the values from your Supabase project
# (Project Settings -> API). .env is git-ignored.
# Both values end up in the browser bundle; the anon key is meant to be public,
# so the data is protected by Row Level Security policies on the `workouts` table.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
